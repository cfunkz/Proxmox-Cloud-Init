# Copy to /etc/create-vm.conf (root-owned, not group/world writable) to change
# the defaults offered by create-vm.sh. Every value is still asked interactively.

#DEF_DISTRO="ubuntu-24.04"      # key from the distro menu
#DEF_STORAGE="local-lvm"
#DEF_BRIDGE="vmbr0"
#DEF_DISK="32G"
#DEF_MEM="2048"
#DEF_CORES="2"
#DEF_CPU="host"                 # x86-64-v2-AES for mixed-CPU clusters (not for EL10)
#DEF_BIOS="ovmf"                # or seabios
#DEF_FW="1"                     # 0 if a router VM (OPNsense etc.) does all filtering
#DEF_SSHKEYS="/root/.ssh/authorized_keys"
#DEF_DNS="1.1.1.1 9.9.9.9"      # blank = gateway of the first static NIC
#DEF_SEARCHDOMAIN="lab.lan"
#DEF_ONBOOT="1"
#DEF_UPGRADE="1"
#SNIPPET_STORAGE="local"
#IMG_DIR="/var/lib/vz/template/cloudimg"
#KEEP_ON_FAIL="0"               # 1 = keep a half-built VM for debugging
